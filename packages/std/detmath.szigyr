// ---- argument reduction (fdlibm e_rem_pio2: medium Cody-Waite, then Payne-Hanek) ----
function remPio2Medium(ax: f64): Rm {
  "use rt";
  const n = Math.floor(ax * INVPIO2 + 0.5);
  const fn = n;
  let r = ax - fn * PIO2_1;
