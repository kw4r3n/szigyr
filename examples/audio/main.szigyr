// Audio demo (ROADMAP stage 3): sound out through SDL3, a C library.
//
// The shape the stage asks for:
// - managed `main` owns the parameters. It pushes Param values into a ring
//   (Ring.create) and a strict function hands the receiving end to SDL inside
//   a box (Ptr.box), so the callback can reach it from SDL's own thread.
// - The callback is an rt function (onAudio). It drains the ring, renders a
//   sine with DetMath into a scratch buffer that lives in C memory
//   (SDL_malloc, held as a CHandle), and feeds SDL_PutAudioStreamData.
//   No allocation, no capabilities, no host calls in the callback itself.
// - Everything C-facing is declared in the c: module below and checked
//   against the real SDL3 headers (P4). This is a C-only program
//   (SPEC 14.7): run it with the C backend, e.g.
//     szigyr run examples/audio/main.szigyr --backend=c
//   With SDL_AUDIO_DRIVER=disk and SDL_AUDIO_DISK_OUTPUT_FILE=<path>, SDL
//   writes the raw stream to a file instead of a device; the automated test
//   (packages/compiler/test/audio-demo.test.ts) uses that to inspect what
//   would have been heard.
declare module "c:sdl3:SDL3/SDL.h" {
  const SDL_INIT_AUDIO: u32;
  const SDL_AUDIO_F32: u32;
  const SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK: u32;
  type SDL_AudioSpec = CStruct<{ format: u32; channels: i32; freq: i32 }>;
  function SDL_Init(ffi: Ffi, flags: u32): boolean;
  function SDL_Quit(ffi: Ffi): void;
  function SDL_Delay(ffi: Ffi, ms: u32): void;
  function SDL_malloc(ffi: Ffi, size: usize): Ptr<void>;
  function SDL_free(ffi: Ffi, mem: Ptr<void>): void;
  function SDL_OpenAudioDeviceStream(ffi: Ffi, dev: u32, spec: ConstPtr<SDL_AudioSpec>, callback: Ptr<(user: Ptr<void>, stream: Ptr<CType<"SDL_AudioStream">>, additional: i32, total: i32) => void>, userdata: Ptr<void>): Ptr<CType<"SDL_AudioStream">>;
  function SDL_ResumeAudioStreamDevice(ffi: Ffi, stream: Ptr<CType<"SDL_AudioStream">>): boolean;
  function SDL_DestroyAudioStream(ffi: Ffi, stream: Ptr<CType<"SDL_AudioStream">>): void;
  function SDL_PutAudioStreamData(ffi: Ffi, stream: Ptr<CType<"SDL_AudioStream">>, buf: ConstPtr<void>, len: i32): boolean;
}
import { SDL_INIT_AUDIO, SDL_AUDIO_F32, SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, SDL_AudioSpec, SDL_Init, SDL_Quit, SDL_Delay, SDL_malloc, SDL_free, SDL_OpenAudioDeviceStream, SDL_ResumeAudioStreamDevice, SDL_DestroyAudioStream, SDL_PutAudioStreamData } from "c:sdl3:SDL3/SDL.h";

// One parameter change, sent from managed to the callback over the ring.
type Param = { readonly freq: f64; readonly gain: f64 };

// Everything the callback needs, boxed behind one pointer (Q209): the ring's
// receiving end, the C scratch buffer, and the oscillator state. The buffer
// is 4096 frames of stereo f32 (32768 bytes); the stream is 48000 Hz.
type AudioState = OwnedStruct<{
  rx: RingRx<Param>;
  buf: CHandle<f32>;
  phase: f64;
  freq: f64;
  gain: f64;
}>;

// The box pointer crosses managed code as a CHandle<void>: the state holds
// a CHandle itself, so it cannot sit inside CHandle (14.5). It is still a
// genuine C heap pointer; stop() casts it back in unsafe code.
type Session = OwnedStruct<{
  state: CHandle<void>;
  stream: CHandle<CType<"SDL_AudioStream">>;
}>;

// Renders `frames` stereo frames into `out`. rt: the phase and the current
// parameters live in the state, so the waveform is continuous across calls.
function fill(st: Mut<AudioState>, out: Mut<Slice<f32>>, frames: usize): void {
  "use rt";
  requires(frames <= divTrunc(out.length, 2));
  for (let i: usize = 0; i < frames; i += 1) {
    const v = f32(st.gain * DetMath.sin(6.283185307179586 * st.phase));
    out[i * 2] = v;
    out[i * 2 + 1] = v;
    st.phase = st.phase + st.freq / 48000;
    if (st.phase >= 1) {
      st.phase = st.phase - 1;
    }
  }
}

// The body of the callback: drain every queued parameter change, then feed
// SDL the bytes it asked for, one scratch buffer at a time.
function render(st: Mut<AudioState>, stream: Ptr<CType<"SDL_AudioStream">>, additional: i32): void {
  "use rt";
  "use unsafe";
  let p = st.rx.pop();
  while (p !== null) {
    st.freq = p.freq;
    st.gain = p.gain;
    p = st.rx.pop();
  }
  if (additional <= 0) {
    return;
  }
  const bp = st.buf.get();
  let want = divTrunc(additional, 8); // bytes -> stereo f32 frames
  while (want > 0) {
    const n: i32 = want > 4096 ? 4096 : want;
    fill(st, bp.slice(usize(n * 2)), usize(n));
    SDL_PutAudioStreamData(stream, bp.cast<void>(), n * 8);
    want = want - n;
  }
}

// The SDL audio stream callback. rt, reached through cfn's trampoline on
// whatever thread SDL calls from (SPEC 14.6, 15.3).
function onAudio(user: Ptr<void>, stream: Ptr<CType<"SDL_AudioStream">>, additional: i32, total: i32): void {
  "use rt";
  "use unsafe";
  render(user.cast<AudioState>().borrow(), stream, additional);
}

function start(ffi: Ffi, alloc: Alloc, rx: RingRx<Param>): Session {
  "use owned";
  "use unsafe";
  const buf = SDL_malloc(ffi, 32768);
  if (buf.isNull()) panic("audio: SDL_malloc failed");
  const specPtr = SDL_malloc(ffi, Ptr.sizeOf<SDL_AudioSpec>()).cast<SDL_AudioSpec>();
  if (specPtr.isNull()) panic("audio: SDL_malloc failed");
  specPtr.write({ format: SDL_AUDIO_F32, channels: 2, freq: 48000 });
  const state: AudioState = { rx, buf: CHandle.create(buf.cast<f32>()), phase: 0, freq: 440, gain: 0.5 };
  const boxed = Ptr.box(alloc, state);
  if (!SDL_Init(ffi, SDL_INIT_AUDIO)) panic("audio: SDL_Init failed");
  const stream = SDL_OpenAudioDeviceStream(ffi, SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, specPtr, cfn(onAudio), boxed.cast<void>());
  if (stream.isNull()) panic("audio: SDL_OpenAudioDeviceStream failed");
  SDL_free(ffi, specPtr.cast<void>());
  if (!SDL_ResumeAudioStreamDevice(ffi, stream)) panic("audio: resume failed");
  return { state: CHandle.create(boxed.cast<void>()), stream: CHandle.create(stream) };
}

function stop(ffi: Ffi, s: Session): void {
  "use owned";
  "use unsafe";
  SDL_DestroyAudioStream(ffi, s.stream.get());
  const boxed = s.state.get().cast<AudioState>();
  const state = boxed.unbox();
  SDL_free(ffi, state.buf.get().cast<void>());
  SDL_Quit(ffi);
}

function delay(ffi: Ffi, ms: u32): void {
  "use owned";
  "use unsafe";
  SDL_Delay(ffi, ms);
}

// Three sine segments, about 0.3 s each: 440, 660, then 880 Hz. The only
// communication with the callback is the pushes into the ring.
export function main(sys: System): void {
  const { tx, rx } = Ring.create<Param>(sys.alloc, 64);
  tx.push({ freq: 440, gain: 0.5 });
  using _session = Resource.ownWith(start(sys.ffi, sys.alloc, rx), sys.ffi, stop);
  delay(sys.ffi, 300);
  tx.push({ freq: 660, gain: 0.5 });
  delay(sys.ffi, 300);
  tx.push({ freq: 880, gain: 0.5 });
  delay(sys.ffi, 300);
}
