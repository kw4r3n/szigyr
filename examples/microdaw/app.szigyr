test("MicroDAW pointer toolbar, grid edit, slider drag, and wheel controls", async (t: Test) => {
  const alloc = TestAlloc.create();
  const audio = FakeAudio.create();
  const clock = FakeClock.create(0);
  const log = MemoryLog.create();

  const d1 = FakeDisplay.create();
  d1.pushEvent({ kind: "pointerDown", x: 12, y: 12, button: 0 }); // PLAY ON
  d1.pushEvent({ kind: "pointerDown", x: 144, y: 12, button: 0 }); // SQR wave (btn 3)
  d1.pushEvent({ kind: "pointerDown", x: 186, y: 12, button: 2 }); // right click TRI MUST be ignored (keeps SQR)
  d1.pushEvent({ kind: "pointerDown", x: 318, y: 12, button: 0 }); // ARP preset (btn 7)
  d1.pushEvent({ kind: "pointerDown", x: 52, y: 198, button: 0 }); // toggle OFF step 0 (arp has 48 at row 7)
  d1.pushEvent({ kind: "pointerDown", x: 82, y: 50, button: 0 }); // toggle ON step 1 -> row 0 (note=72, vel=0.85)
  d1.pushEvent({ kind: "pointerDown", x: 128, y: 260, button: 0 }); // direct click CUT slider -> 6060 (no drag overwrite)
  d1.pushEvent({ kind: "pointerUp", x: 128, y: 260, button: 0 });
  d1.pushEvent({ kind: "pointerDown", x: 128, y: 240, button: 0 }); // drag BPM slider -> 140
  d1.pushEvent({ kind: "pointerUp", x: 168, y: 240, button: 2 }); // right pointerUp -> keeps drag active
  d1.pushEvent({ kind: "pointerMove", x: 168, y: 240, buttons: 1 }); // drag BPM slider -> 190
  d1.pushEvent({ kind: "pointerMove", x: 48, y: 240, buttons: 0 }); // buttons=0 at 48 -> must NOT drop to 40
  d1.pushEvent({ kind: "pointerUp", x: 168, y: 240, button: 0 }); // ends drag
  d1.pushEvent({ kind: "pointerMove", x: 48, y: 240, buttons: 1 }); // drag stopped -> stays 190
  d1.pushEvent({ kind: "pointerDown", x: 496, y: 12, button: 0 }); // BPM+ (btn 11) -> 195
  d1.pushEvent({ kind: "close" });
  d1.pushEvent({ kind: "pointerDown", x: 406, y: 12, button: 0 }); // trailing ignored
  const r1 = await runMicroDawStudio(alloc, d1, audio, clock, log, 1, 1, 0, false);
  t.eq(r1.kind, "ok");
  if (r1.kind === "ok") {
    t.eq(r1.value.audioOpen, true);
    t.eq(r1.value.snapshot.playing, true);
    t.eq(r1.value.snapshot.wave, WAVE_SQUARE);
    t.eq(r1.value.snapshot.preset, "arp");
    t.eq(r1.value.snapshot.bpm, u8(195));
    t.eq(r1.value.snapshot.cutoff, f32(6060));
    t.eq(r1.value.snapshot.steps[0].note, u8(0));
    t.eq(r1.value.snapshot.steps[0].vel, f32(0));
    t.eq(r1.value.snapshot.steps[1].note, u8(72));
    t.eq(r1.value.snapshot.steps[1].vel, f32(0.85));
  }

  // Boundary buttons & wheel on BPM (bar=0)
  const dB1 = FakeDisplay.create();
  dB1.pushEvent({ kind: "keyDown", key: "Space", repeat: false, shift: false, ctrl: false, alt: false }); // playing=true
  dB1.pushEvent({ kind: "pointerDown", x: 12, y: 12, button: 0 }); // STOP off (btn 0)
  dB1.pushEvent({ kind: "pointerDown", x: 230, y: 12, button: 0 }); // SIN (btn 5)
  dB1.pushEvent({ kind: "pointerDown", x: 406, y: 12, button: 0 }); // CLR (btn 9 -> empty)
  dB1.pushEvent({ kind: "pointerDown", x: 452, y: 12, button: 0 }); // BPM- (btn 10 -> 115)
  dB1.pushEvent({ kind: "wheel", x: 128, y: 240, dx: 0, dy: -120 }); // wheel on bar 0 (BPM 115 -> 125)
  const rB1 = await runMicroDawStudio(alloc, dB1, audio, clock, log, 1, 1, 2, false);
  t.eq(rB1.kind, "ok");
  if (rB1.kind === "ok") {
    t.eq(rB1.value.snapshot.playing, false);
    t.eq(rB1.value.snapshot.wave, WAVE_SINE);
    t.eq(rB1.value.snapshot.preset, "empty");
    t.eq(rB1.value.snapshot.bpm, u8(125));
  }

  // SAW/ACID boundary buttons + wheel on CUT (dy:0/-120) and VOL (dy:1)
  const dB2 = FakeDisplay.create();
  dB2.pushEvent({ kind: "keyDown", key: "4", repeat: false, shift: false, ctrl: false, alt: false }); // SINE first
  dB2.pushEvent({ kind: "pointerDown", x: 406, y: 12, button: 0 }); // empty first
  dB2.pushEvent({ kind: "pointerDown", x: 100, y: 12, button: 0 }); // SAW (btn 2)
  dB2.pushEvent({ kind: "pointerDown", x: 276, y: 12, button: 0 }); // ACID (btn 6)
  dB2.pushEvent({ kind: "wheel", x: 128, y: 260, dx: 0, dy: 0 }); // dy=0 -> no-op
  dB2.pushEvent({ kind: "wheel", x: 128, y: 260, dx: 0, dy: -120 }); // CUT +5% -> ~2994
  dB2.pushEvent({ kind: "wheel", x: 128, y: 282, dx: 0, dy: 1 }); // VOL -5% (dy=1 tests >0 vs >1)
  const rB2 = await runMicroDawStudio(alloc, dB2, audio, clock, log, 1, 1, 2, false);
  t.eq(rB2.kind, "ok");
  if (rB2.kind === "ok") {
    t.eq(rB2.value.snapshot.wave, WAVE_SAW);
    t.eq(rB2.value.snapshot.preset, "acid");
    t.ok(rB2.value.snapshot.cutoff > f32(2900) && rB2.value.snapshot.cutoff < f32(3050));
    t.ok(rB2.value.snapshot.gain > f32(0.58) && rB2.value.snapshot.gain < f32(0.62));
  }
});

test("MicroDAW keyboard shortcuts and idle pointer move guards", async (t: Test) => {
  const alloc = TestAlloc.create();
  const audio = FakeAudio.create();
  const clock = FakeClock.create(0);
  const log = MemoryLog.create();

  const dK1 = FakeDisplay.create();
  dK1.pushEvent({ kind: "pointerMove", x: 208, y: 240, buttons: 1 }); // dragParam=-1 must ignore
  dK1.pushEvent({ kind: "keyDown", key: "Space", repeat: false, shift: false, ctrl: false, alt: false }); // playing=true
  dK1.pushEvent({ kind: "keyDown", key: "3", repeat: false, shift: false, ctrl: false, alt: false }); // TRI
  dK1.pushEvent({ kind: "keyDown", key: "ArrowUp", repeat: false, shift: false, ctrl: false, alt: false }); // 125
  dK1.pushEvent({ kind: "keyDown", key: "Escape", repeat: false, shift: false, ctrl: false, alt: false });
  dK1.pushEvent({ kind: "keyDown", key: "1", repeat: false, shift: false, ctrl: false, alt: false }); // trailing ignored
  const rK1 = await runMicroDawStudio(alloc, dK1, audio, clock, log, 1, 1, 0, false);
  t.eq(rK1.kind, "ok");
  if (rK1.kind === "ok") {
    t.eq(rK1.value.frames, usize(1));
    t.eq(rK1.value.audioOpen, true);
    t.eq(rK1.value.snapshot.playing, true);
    t.eq(rK1.value.snapshot.wave, WAVE_TRI);
    t.eq(rK1.value.snapshot.bpm, u8(125));
  }

  const dKp = FakeDisplay.create();
  dKp.pushEvent({ kind: "keyDown", key: "p", repeat: false, shift: false, ctrl: false, alt: false }); // p ON
  const rKp = await runMicroDawStudio(alloc, dKp, audio, clock, log, 1, 1, 2, false);
  t.eq(rKp.kind, "ok");
  if (rKp.kind === "ok") {
    t.eq(rKp.value.audioOpen, true);
    t.eq(rKp.value.snapshot.playing, true);
  }

  const dK2 = FakeDisplay.create();
  dK2.pushEvent({ kind: "keyDown", key: "p", repeat: false, shift: false, ctrl: false, alt: false }); // p ON
  dK2.pushEvent({ kind: "keyDown", key: "p", repeat: false, shift: false, ctrl: false, alt: false }); // p OFF
  dK2.pushEvent({ kind: "keyDown", key: "4", repeat: false, shift: false, ctrl: false, alt: false }); // SINE
  dK2.pushEvent({ kind: "keyDown", key: "1", repeat: false, shift: false, ctrl: false, alt: false }); // SAW
  dK2.pushEvent({ kind: "keyDown", key: "ArrowDown", repeat: false, shift: false, ctrl: false, alt: false }); // 115
  const rK2 = await runMicroDawStudio(alloc, dK2, audio, clock, log, 1, 1, 2, false);
  t.eq(rK2.kind, "ok");
  if (rK2.kind === "ok") {
    t.eq(rK2.value.snapshot.playing, false);
    t.eq(rK2.value.snapshot.wave, WAVE_SAW);
    t.eq(rK2.value.snapshot.bpm, u8(115));
  }

  const dK3 = FakeDisplay.create();
  dK3.pushEvent({ kind: "keyDown", key: "2", repeat: false, shift: false, ctrl: false, alt: false }); // SQR
  dK3.pushEvent({ kind: "keyDown", key: "q", repeat: false, shift: false, ctrl: false, alt: false }); // unmapped key -> audio off
  dK3.pushEvent({ kind: "keyUp", key: "a", shift: false, ctrl: false, alt: false });
  const rK3 = await runMicroDawStudio(alloc, dK3, audio, clock, log, 1, 1, 2, false);
  t.eq(rK3.kind, "ok");
  if (rK3.kind === "ok") {
    t.eq(rK3.value.audioOpen, false);
    t.eq(rK3.value.snapshot.wave, WAVE_SQUARE);
  }

  const dK4 = FakeDisplay.create();
  dK4.pushEvent({ kind: "keyDown", key: "4", repeat: false, shift: false, ctrl: false, alt: false }); // SINE
  dK4.pushEvent({ kind: "keyDown", key: "a", repeat: false, shift: false, ctrl: false, alt: false }); // key 'a' ensures audio
  const rK4 = await runMicroDawStudio(alloc, dK4, audio, clock, log, 1, 1, 2, false);
  t.eq(rK4.kind, "ok");
  if (rK4.kind === "ok") {
    t.eq(rK4.value.audioOpen, true);
    t.eq(rK4.value.snapshot.wave, WAVE_SINE);
  }
  const logs = log.entries();
  t.ok(logs[logs.length - 1].message.includes("microdaw:frames=2:"));
});

test("MicroDAW live DSP pad trigger and sequencer reset sync", async (t: Test) => {
  const alloc = TestAlloc.create();
  const audio = FakeAudio.create();
  const clock = FakeClock.create(0);
  const log = MemoryLog.create();

  const sTrig = createSession(alloc);
  t.eq((await sTrig.startAudio(audio)).kind, "ok");
  const dTrigPad = FakeDisplay.create();
  dTrigPad.pushEvent({ kind: "pointerDown", x: 52, y: 310, button: 0 });
  await runMicroDawSession(sTrig, dTrigPad, audio, clock, log, 1, 1, 2, false);
  t.eq(audio.renderFrames(1024).length, usize(2048));
  const telPad = sTrig.pollTelemetry();
  t.ok(telPad !== null && telPad.peak > f32(0.1));
  await sTrig.stopAudio();

  const sTrigKey = createSession(alloc);
  t.eq((await sTrigKey.startAudio(audio)).kind, "ok");
  const dTrigKey = FakeDisplay.create();
  dTrigKey.pushEvent({ kind: "keyDown", key: "a", repeat: false, shift: false, ctrl: false, alt: false });
  const rTrigKey = await runMicroDawSession(sTrigKey, dTrigKey, audio, clock, log, 1, 1, 2, false);
  t.eq(rTrigKey.kind, "ok");
  t.eq(audio.renderFrames(1024).length, usize(2048));
  const telKey = sTrigKey.pollTelemetry();
  t.ok(telKey !== null && telKey.peak > f32(0.1));
  await sTrigKey.stopAudio();

  const sRstBtn = createSession(alloc);
  t.eq((await sRstBtn.startAudio(audio)).kind, "ok");
  sRstBtn.setBpm(240);
  sRstBtn.setPlaying(true);
  t.eq(audio.renderFrames(3072).length, usize(6144));
  const dRstBtn = FakeDisplay.create();
  dRstBtn.pushEvent({ kind: "pointerDown", x: 56, y: 12, button: 0 }); // RST
  const rRstBtn = await runMicroDawSession(sRstBtn, dRstBtn, audio, clock, log, 1, 1, 2, false);
  t.eq(rRstBtn.kind, "ok");
  if (rRstBtn.kind === "ok") t.eq(rRstBtn.value.lastStep, u8(0));
  t.eq(audio.renderFrames(1024).length, usize(2048));
  const telRstBtn = sRstBtn.pollTelemetry();
  t.ok(telRstBtn !== null && telRstBtn.step === u8(0));
  await sRstBtn.stopAudio();

  const sRstKey = createSession(alloc);
  t.eq((await sRstKey.startAudio(audio)).kind, "ok");
  sRstKey.setBpm(240);
  sRstKey.setPlaying(true);
  t.eq(audio.renderFrames(3072).length, usize(6144));
  const dRstKey = FakeDisplay.create();
  dRstKey.pushEvent({ kind: "keyDown", key: "r", repeat: false, shift: false, ctrl: false, alt: false });
  const rRstKey = await runMicroDawSession(sRstKey, dRstKey, audio, clock, log, 1, 1, 2, false);
  t.eq(rRstKey.kind, "ok");
  if (rRstKey.kind === "ok") t.eq(rRstKey.value.lastStep, u8(0));
  t.eq(audio.renderFrames(1024).length, usize(2048));
  const telRstKey = sRstKey.pollTelemetry();
  t.ok(telRstKey !== null && telRstKey.step === u8(0));
  await sRstKey.stopAudio();
});

test("AudioGuard, autoplay, and FakeDisplay pad flash lifecycle", async (t: Test) => {
  const alloc = TestAlloc.create();
  const audio = FakeAudio.create();
  const clock = FakeClock.create(0);
  const log = MemoryLog.create();

  const sGuard = createSession(alloc);
  if (true) {
    await using _g = new AudioGuard(sGuard);
    t.eq((await sGuard.startAudio(audio)).kind, "ok");
    t.ok(sGuard.isAudioOpen());
  }
  t.ok(!sGuard.isAudioOpen());

  // Fresh autoplay=true opens audio & sets playing=true cleanly on 1x1 display
  const dAuto = FakeDisplay.create();
  const rAuto = await runMicroDawStudio(alloc, dAuto, audio, clock, log, 1, 1, 1, true);
  t.eq(rAuto.kind, "ok");
  if (rAuto.kind === "ok") {
    t.eq(rAuto.value.audioOpen, true);
    t.eq(rAuto.value.snapshot.playing, true);
  }
  t.eq(clock.nowMs(), 0); // single frame does not sleep

  const dPadMiss = FakeDisplay.create();
  dPadMiss.pushEvent({ kind: "pointerDown", x: 10, y: 310, button: 0 }); // outside pads/grid/bars
  const rPadMiss = await runMicroDawStudio(alloc, dPadMiss, audio, clock, log, 1, 1, 2, false);
  t.eq(rPadMiss.kind, "ok");
  if (rPadMiss.kind === "ok") t.eq(rPadMiss.value.audioOpen, false);

  const dPadFlash = FakeDisplay.create();
  dPadFlash.pushEvent({ kind: "pointerDown", x: 52, y: 310, button: 0 }); // PAD 0
  const rPadFlash = await runMicroDawApp(alloc, dPadFlash, audio, clock, log, 2, false);
  t.eq(rPadFlash.kind, "ok");
  if (rPadFlash.kind === "ok") t.eq(rPadFlash.value.audioOpen, true);
  t.eq(dPadFlash.pixelAt(52, 308).r, u8(244));
  t.eq(dPadFlash.pixelAt(52, 308).g, u8(196));
  t.eq(dPadFlash.pixelAt(52, 308).b, u8(64));

  const dPadClear = FakeDisplay.create();
  dPadClear.pushEvent({ kind: "pointerDown", x: 52, y: 310, button: 0 }); // frame 1 flash, frame 2 cleared
  const rPadClear = await runMicroDawApp(alloc, dPadClear, audio, clock, log, 3, false);
  t.eq(rPadClear.kind, "ok");
  t.eq(dPadClear.pixelAt(52, 308).r, u8(30));
});

test("FakeDisplay renders exact RGBA palette, grid margins, sliders, scope, meter, and texts", async (t: Test) => {
  const alloc = TestAlloc.create();
  const display = FakeDisplay.create();
  const audio = FakeAudio.create();
  const clock = FakeClock.create(0);
  const log = MemoryLog.create();

  const eqRgba = (c: DisplayColor, r: u8, g: u8, b: u8, a: u8): void => {
    t.eq(c.r, r);
    t.eq(c.g, g);
    t.eq(c.b, b);
    t.eq(c.a, a);
  };

  // Open error path
  const bad = await runMicroDawStudio(alloc, display, audio, clock, log, 0, 360, 1, false);
  t.eq(bad.kind, "err");

  // Render live DSP audio frames so pollTelemetry() populates scope bars, peak meter, and playhead
  const s = createSession(alloc);
  const stRes = await s.startAudio(audio);
  t.eq(stRes.kind, "ok");
  s.setPlaying(true);
  t.eq(audio.renderFrames(1024).length, usize(2048));

  // First 2 frames: newest peak at i=15 (x=470..482), i=14 (x=454..466), i=0 still empty
  const res = await runMicroDawSession(s, display, audio, clock, log, 540, 360, 2, true);
  t.eq(res.kind, "ok");
  t.eq(display.presentCount(), usize(2));
  t.eq(clock.nowMs(), 15);
  let resPeak = f32(0);
  if (res.kind === "ok") {
    t.eq(res.value.frames, usize(2));
    t.eq(res.value.audioOpen, true);
    t.eq(res.value.lastStep, u8(0));
    t.ok(res.value.peak > f32(0.1) && res.value.peak < f32(0.8));
    resPeak = res.value.peak;
  }
  const wantPct = Math.round(clamp01(f64(resPeak)) * 100);
  const logList = log.entries();
  t.ok(logList[logList.length - 1].message.includes(`step=0:peak=${wantPct}`));

  // Palette & margins (bg={16,18,22,255})
  eqRgba(display.pixelAt(0, 0), u8(16), u8(18), u8(22), u8(255));
  eqRgba(display.pixelAt(535, 3), u8(16), u8(18), u8(22), u8(255));
  eqRgba(display.pixelAt(529, 45), u8(16), u8(18), u8(22), u8(255)); // col < 16
  eqRgba(display.pixelAt(49, 221), u8(16), u8(18), u8(22), u8(255)); // row < 8
  eqRgba(display.pixelAt(530, 310), u8(16), u8(18), u8(22), u8(255)); // p < 8

  // Toolbar buttons: PLAY green, RST panel, SAW & ACID accent, border
  eqRgba(display.pixelAt(12, 12), u8(40), u8(168), u8(108), u8(255));
  eqRgba(display.pixelAt(6, 6), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(47, 29), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(56, 12), u8(30), u8(34), u8(42), u8(255));
  eqRgba(display.pixelAt(100, 12), u8(44), u8(112), u8(226), u8(255));
  eqRgba(display.pixelAt(276, 12), u8(44), u8(112), u8(226), u8(255));
  eqRgba(display.pixelAt(496, 12), u8(30), u8(34), u8(42), u8(255));

  // Step grid 1px margins, cell borders & interior colors
  eqRgba(display.pixelAt(48, 204), u8(16), u8(18), u8(22), u8(255));
  eqRgba(display.pixelAt(52, 198), u8(16), u8(18), u8(22), u8(255));
  eqRgba(display.pixelAt(76, 204), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(77, 204), u8(16), u8(18), u8(22), u8(255));
  eqRgba(display.pixelAt(52, 218), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(52, 219), u8(16), u8(18), u8(22), u8(255));
  eqRgba(display.pixelAt(52, 204), u8(244), u8(196), u8(64), u8(255));
  eqRgba(display.pixelAt(52, 48), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(49, 199), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(76, 217), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(112, 204), u8(44), u8(112), u8(226), u8(255));
  eqRgba(display.pixelAt(172, 48), u8(30), u8(34), u8(42), u8(255));
  eqRgba(display.pixelAt(82, 48), u8(16), u8(18), u8(22), u8(255));

  // Parameter sliders (BPM=120 -> x=112, CUT=2400 -> x=78.7, VOL=0.65 -> x=152)
  eqRgba(display.pixelAt(48, 232), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(207, 247), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(108, 240), u8(44), u8(112), u8(226), u8(255));
  eqRgba(display.pixelAt(115, 240), u8(30), u8(34), u8(42), u8(255));
  eqRgba(display.pixelAt(78, 262), u8(44), u8(112), u8(226), u8(255));
  eqRgba(display.pixelAt(79, 262), u8(30), u8(34), u8(42), u8(255));
  eqRgba(display.pixelAt(149, 284), u8(44), u8(112), u8(226), u8(255));
  eqRgba(display.pixelAt(155, 284), u8(30), u8(34), u8(42), u8(255));

  // Scope border, center-line edges, active trailing bars i=14/15 + bottom half, and exact peak meter height
  eqRgba(display.pixelAt(224, 232), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(499, 291), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(225, 262), u8(30), u8(34), u8(42), u8(255)); // inside box before line start 226
  eqRgba(display.pixelAt(226, 262), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(498, 262), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(500, 262), u8(16), u8(18), u8(22), u8(255)); // right of scope border
  eqRgba(display.pixelAt(234, 260), u8(30), u8(34), u8(42), u8(255)); // i=0 empty panel on frame 2
  eqRgba(display.pixelAt(458, 260), u8(40), u8(168), u8(108), u8(255)); // i=14 green bar
  eqRgba(display.pixelAt(474, 260), u8(40), u8(168), u8(108), u8(255)); // i=15 green bar upper half
  eqRgba(display.pixelAt(474, 265), u8(40), u8(168), u8(108), u8(255)); // i=15 green bar lower half (kills *2 -> +2)
  eqRgba(display.pixelAt(474, 236), u8(30), u8(34), u8(42), u8(255));
  eqRgba(display.pixelAt(508, 232), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(527, 291), u8(58), u8(64), u8(78), u8(255));
  const expectedMeterTop: u32 = 290 - u32(Math.round(clamp01(f64(resPeak)) * 56));
  eqRgba(display.pixelAt(518, expectedMeterTop), u8(40), u8(168), u8(108), u8(255));
  eqRgba(display.pixelAt(518, expectedMeterTop - 1), u8(30), u8(34), u8(42), u8(255));
  eqRgba(display.pixelAt(518, 288), u8(40), u8(168), u8(108), u8(255));
  eqRgba(display.pixelAt(518, 236), u8(30), u8(34), u8(42), u8(255));

  // Piano pads & all 32 drawnTexts coordinates, labels, ink RGBA
  eqRgba(display.pixelAt(48, 304), u8(58), u8(64), u8(78), u8(255));
  eqRgba(display.pixelAt(52, 310), u8(30), u8(34), u8(42), u8(255));
  eqRgba(display.pixelAt(472, 310), u8(30), u8(34), u8(42), u8(255));

  const ts = display.drawnTexts();
  t.eq(ts.length, usize(32));
  t.eq(ts[0].x, 10);
  t.eq(ts[0].y, 12);
  t.eq(ts[0].text, "STOP");
  eqRgba(ts[0].color, u8(232), u8(235), u8(240), u8(255));
  t.eq(ts[1].x, 54);
  t.eq(ts[1].text, "RST");
  t.eq(ts[11].x, 494);
  t.eq(ts[11].text, "BPM+");
  t.eq(ts[12].x, 8);
  t.eq(ts[12].y, 49);
  t.eq(ts[12].text, "C5");
  t.eq(ts[19].x, 8);
  t.eq(ts[19].y, 203);
  t.eq(ts[19].text, "C3");
  t.eq(ts[20].x, 8);
  t.eq(ts[20].y, 234);
  t.eq(ts[20].text, "BPM");
  t.eq(ts[22].x, 8);
  t.eq(ts[22].y, 278);
  t.eq(ts[22].text, "VOL");
  t.eq(ts[23].x, 54);
  t.eq(ts[23].y, 312);
  t.eq(ts[23].text, "C3 A");
  t.eq(ts[30].x, 474);
  t.eq(ts[30].y, 312);
  t.eq(ts[30].text, "C5 K");
  t.eq(ts[31].x, 8);
  t.eq(ts[31].y, 342);
  t.ok(ts[31].text.includes(`audio=on bpm=120 wave=saw preset=acid step=0 peak=${wantPct}%`));

  // Direct 1-frame render with full 16-entry history -> kills i=0->1, SCOPE_X+6->+0, i<HIST_LEN->i<=HIST_LEN
  const openFull = await display.open({ title: "full", width: 540, height: 360 });
  t.eq(openFull.kind, "ok");
  if (openFull.kind === "ok") {
    await using surf = openFull.value;
    const fullHist: Array<f32> = [];
    for (let i: usize = 0; i < HIST_LEN; i += 1) fullHist.push(resPeak);
    await renderDawFrame(surf, s, 0, resPeak, fullHist, 0, -1);
  }
  eqRgba(display.pixelAt(228, 260), u8(30), u8(34), u8(42), u8(255)); // left margin before bar 0
  eqRgba(display.pixelAt(234, 260), u8(40), u8(168), u8(108), u8(255)); // i=0 bar drawn
  eqRgba(display.pixelAt(488, 260), u8(30), u8(34), u8(42), u8(255)); // right margin stays panel (i < 16)

  // SINE wave (btn 5) + empty preset (btn 9) highlight bounds + step > 0 telemetry
  s.setWave(WAVE_SINE);
  s.loadPreset("empty");
  s.setBpm(240);
  t.eq(audio.renderFrames(2048).length, usize(4096));
  const dHi = FakeDisplay.create();
  const resHi = await runMicroDawSession(s, dHi, audio, clock, log, 540, 360, 1, false);
  t.eq(resHi.kind, "ok");
  if (resHi.kind === "ok") t.ok(resHi.value.lastStep > u8(0));
  eqRgba(dHi.pixelAt(230, 12), u8(44), u8(112), u8(226), u8(255)); // SIN active
  eqRgba(dHi.pixelAt(406, 12), u8(44), u8(112), u8(226), u8(255)); // CLR active ("empty")
  eqRgba(dHi.pixelAt(56, 12), u8(30), u8(34), u8(42), u8(255)); // RST stays panel despite presetByIndex(-5)==="empty"
  await s.stopAudio();

  // Single-frame idle state checks flashPad initial -1 & lastStep initial 0
  const dOff = FakeDisplay.create();
  const resOff = await runMicroDawApp(alloc, dOff, audio, clock, log, 1, false);
  t.eq(resOff.kind, "ok");
  eqRgba(dOff.pixelAt(518, 288), u8(30), u8(34), u8(42), u8(255));
  eqRgba(dOff.pixelAt(12, 12), u8(30), u8(34), u8(42), u8(255));
  eqRgba(dOff.pixelAt(52, 310), u8(30), u8(34), u8(42), u8(255));
  const tsOff = dOff.drawnTexts();
  t.eq(tsOff[0].text, "PLAY");
  t.ok(tsOff[31].text.includes("audio=off"));
  t.ok(tsOff[31].text.includes("step=0 peak=0%"));
});
