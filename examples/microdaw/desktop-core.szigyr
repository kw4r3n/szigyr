export type DesktopAction =
  | { readonly kind: "help" }
  | {
      readonly kind: "run";
      readonly webDir: string;
      readonly title: string;
      readonly width: i32;
      readonly height: i32;
      readonly smokeMs: u32 | null;
    }
  | { readonly kind: "error"; readonly message: string };

export function mimeTypeForPath(relPath: string): string {
  if (relPath.endsWith(".html")) return "text/html; charset=utf-8";
  if (relPath.endsWith(".css")) return "text/css; charset=utf-8";
  if (relPath.endsWith(".js") || relPath.endsWith(".mjs")) return "application/javascript; charset=utf-8";
  if (relPath.endsWith(".json")) return "application/json; charset=utf-8";
  if (relPath.endsWith(".svg")) return "image/svg+xml";
  if (relPath.endsWith(".wasm")) return "application/wasm";
  return "application/octet-stream";
}

export function sanitizeAssetPath(urlPath: string): string | null {
  if (!urlPath.startsWith("/")) return null;
  if (urlPath === "/") return "index.html";
  const rel = urlPath.slice(1);
  if (rel.includes("\\")) return null;
  for (let i: usize = 0; i < rel.length; i += 1) {
    if (rel.charCodeAt(i) === 0) return null;
  }
  const segs = rel.split("/");
  for (const seg of segs) {
    if (seg.length === 0 || seg === "." || seg === "..") return null;
  }
  return segs.join("/");
}

function parseBoundedPosInt(raw: string, maxVal: u64): u32 | null {
  let acc: u64 = 0;
  for (let i: usize = 0; i < raw.length; i += 1) {
    const ch = raw.charCodeAt(i);
    if (ch < 48 || ch > 57) return null;
    acc = acc * 10 + u64(ch - 48);
    if (acc > maxVal) return null;
  }
  if (acc === 0) return null;
  return u32(acc);
}

export function desktopHelpText(): string {
  return "Usage: microdaw-desktop [--web-dir <dir>] [--title <title>] [--width <px>] [--height <px>] [--smoke-ms <ms>]";
}

export function parseDesktopArgs(argv: ReadonlyArray<string>): DesktopAction {
  let webDir = ".";
  let title = "MicroDAW Studio";
  let width: i32 = 1120;
  let height: i32 = 760;
  let smokeMs: u32 | null = null;

  let i: usize = 0;
  while (i < argv.length) {
    const flag = argv[i];
    if (flag === "--help" || flag === "-h") return { kind: "help" };
    if (
      flag !== "--web-dir" &&
      flag !== "--title" &&
      flag !== "--width" &&
      flag !== "--height" &&
      flag !== "--smoke-ms"
    ) {
      return { kind: "error", message: `unknown argument: ${flag}` };
    }
    if (i + 1 >= argv.length) return { kind: "error", message: `missing value for ${flag}` };
    const val = argv[i + 1];
    if (flag === "--web-dir") {
      if (val.length === 0) return { kind: "error", message: "empty --web-dir" };
      webDir = val;
    } else if (flag === "--title") {
      if (val.length === 0) return { kind: "error", message: "empty --title" };
      title = val;
    } else if (flag === "--width") {
      const n = parseBoundedPosInt(val, 8192);
      if (n === null) return { kind: "error", message: `invalid --width: ${val}` };
      width = i32(n);
    } else if (flag === "--height") {
      const n = parseBoundedPosInt(val, 8192);
      if (n === null) return { kind: "error", message: `invalid --height: ${val}` };
      height = i32(n);
    } else {
      const n = parseBoundedPosInt(val, 300000);
      if (n === null) return { kind: "error", message: `invalid --smoke-ms: ${val}` };
      smokeMs = n;
    }
    i += 2;
  }
  return { kind: "run", webDir, title, width, height, smokeMs };
}

function coiHeaders(contentType: string): Array<HttpHeader> {
  return [
    { name: "content-type", value: contentType },
    { name: "cross-origin-opener-policy", value: "same-origin" },
    { name: "cross-origin-embedder-policy", value: "require-corp" },
  ];
}

export function joinAssetPath(baseDir: string, rel: string): string {
  if (baseDir.endsWith("/")) return baseDir + rel;
  return `${baseDir}/${rel}`;
}

function textResp(status: u16, contentType: string, value: string): HttpServerRawResponse {
  return { status, headers: coiHeaders(contentType), body: { kind: "text", value } };
}

export function handleDesktopRequest(
  fs: Fs,
  alloc: Alloc,
  webDir: string,
  req: HttpServerRequest,
  onReady: (body: string) => void,
): HttpServerRawResponse {
  if (req.method === "GET" && req.path === "/api/health") {
    return textResp(200, "application/json; charset=utf-8", "{\"ok\":true}");
  }
  if (req.method === "POST" && req.path === "/api/ready") {
    onReady(req.body);
    return textResp(200, "application/json; charset=utf-8", "{\"ok\":true}");
  }
  const rel = sanitizeAssetPath(req.path);
  if (rel === null) {
    return textResp(400, "text/plain; charset=utf-8", "bad path");
  }
  const full = joinAssetPath(webDir, rel);
  if (rel.endsWith(".wasm")) {
    const buf = Vec.create<u8>(alloc, 0);
    const rd = fs.readBytes(full, buf);
    if (rd.kind === "err") {
      return textResp(404, "text/plain; charset=utf-8", "not found");
    }
    const bytes: Array<u8> = [];
    for (let i: usize = 0; i < buf.length; i += 1) bytes.push(buf[i]);
    return { status: 200, headers: coiHeaders(mimeTypeForPath(rel)), body: { kind: "bytes", value: bytes } };
  }
  const rd = fs.readText(full);
  if (rd.kind === "err") {
    return textResp(404, "text/plain; charset=utf-8", "not found");
  }
  return textResp(200, mimeTypeForPath(rel), rd.value);
}

test("mimeTypeForPath, sanitizeAssetPath, parseDesktopArgs, and handleDesktopRequest", (t: Test) => {
  t.eq(mimeTypeForPath("index.html"), "text/html; charset=utf-8");
  t.eq(mimeTypeForPath("style.css"), "text/css; charset=utf-8");
  t.eq(mimeTypeForPath("app.js"), "application/javascript; charset=utf-8");
  t.eq(mimeTypeForPath("mod.mjs"), "application/javascript; charset=utf-8");
  t.eq(mimeTypeForPath("data.json"), "application/json; charset=utf-8");
  t.eq(mimeTypeForPath("icon.svg"), "image/svg+xml");
  t.eq(mimeTypeForPath("prog.wasm"), "application/wasm");
  t.eq(mimeTypeForPath("blob.bin"), "application/octet-stream");

  t.eq(sanitizeAssetPath("/"), "index.html");
  t.eq(sanitizeAssetPath("/ui.js"), "ui.js");
  t.eq(sanitizeAssetPath("/rt/browser.js"), "rt/browser.js");
  t.ok(sanitizeAssetPath("ui.js") === null);
  t.ok(sanitizeAssetPath("") === null);
  t.ok(sanitizeAssetPath("//etc/passwd") === null);
  t.ok(sanitizeAssetPath("/a/") === null);
  t.ok(sanitizeAssetPath("/../secret") === null);
  t.ok(sanitizeAssetPath("/./a") === null);
  t.ok(sanitizeAssetPath("/a\\b") === null);
  t.ok(sanitizeAssetPath("/\0b") === null);
  t.ok(sanitizeAssetPath("/a\0b") === null);

  t.eq(joinAssetPath("/web/", "ui.js"), "/web/ui.js");
  t.eq(joinAssetPath("/web", "ui.js"), "/web/ui.js");

  t.ok(desktopHelpText().includes("--smoke-ms"));
  t.eq(parseDesktopArgs([]), {
    kind: "run",
    webDir: ".",
    title: "MicroDAW Studio",
    width: 1120,
    height: 760,
    smokeMs: null,
  });
  t.eq(parseDesktopArgs(["--help"]), { kind: "help" });
  t.eq(parseDesktopArgs(["-h"]), { kind: "help" });
  t.eq(parseDesktopArgs(["--web-dir", "/app/web", "--title", "DAW", "--width", "8192", "--height", "480", "--smoke-ms", "300000"]), {
    kind: "run",
    webDir: "/app/web",
    title: "DAW",
    width: 8192,
    height: 480,
    smokeMs: u32(300000),
  });

  const bogus = parseDesktopArgs(["--bogus"]);
  t.eq(bogus.kind, "error");
  if (bogus.kind === "error") t.ok(bogus.message.includes("unknown argument"));
  t.eq(parseDesktopArgs(["--web-dir"]).kind, "error");
  t.eq(parseDesktopArgs(["--web-dir", ""]).kind, "error");
  t.eq(parseDesktopArgs(["--title", ""]).kind, "error");
  t.eq(parseDesktopArgs(["--width", "0"]).kind, "error");
  t.eq(parseDesktopArgs(["--width", "8193"]).kind, "error");
  t.eq(parseDesktopArgs(["--width", "/"]).kind, "error");
  t.eq(parseDesktopArgs(["--width", ":"]).kind, "error");
  t.eq(parseDesktopArgs(["--height", "0"]).kind, "error");
  t.eq(parseDesktopArgs(["--height", "8193"]).kind, "error");
  t.eq(parseDesktopArgs(["--smoke-ms", "0"]).kind, "error");
  t.eq(parseDesktopArgs(["--smoke-ms", "300001"]).kind, "error");

  const alloc = TestAlloc.create();
  const fs = FakeFs.create();
  fs.mkdir("/web/rt");
  fs.writeText("/web/index.html", "<h1>ok</h1>");
  fs.writeText("/web/rt/browser.js", "export const x = 1;");
  const wasmBytes: Array<u8> = [u8(0x00), 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00];
  const wasmHdr = Vec.create<u8>(alloc, 8);
  for (const b of wasmBytes) wasmHdr.push(b);
  fs.writeBytes("/web/program.wasm", wasmHdr);

  let capturedReady = "";
  const onReady = (b: string): void => {
    capturedReady = b;
  };

  const health = handleDesktopRequest(fs, alloc, "/web", { method: "GET", path: "/api/health", query: "", headers: [], body: "" }, onReady);
  t.eq(health.status, u16(200));
  t.eq(health.body, { kind: "text", value: "{\"ok\":true}" });
  t.eq(health.headers[0].value, "application/json; charset=utf-8");
  t.eq(health.headers[1], { name: "cross-origin-opener-policy", value: "same-origin" });
  t.eq(health.headers[2], { name: "cross-origin-embedder-policy", value: "require-corp" });

  const postHealth = handleDesktopRequest(fs, alloc, "/web", { method: "POST", path: "/api/health", query: "", headers: [], body: "" }, onReady);
  t.eq(postHealth.status, u16(404));

  const ready = handleDesktopRequest(fs, alloc, "/web", { method: "POST", path: "/api/ready", query: "", headers: [], body: "{\"ok\":true}" }, onReady);
  t.eq(ready.status, u16(200));
  t.eq(ready.body, { kind: "text", value: "{\"ok\":true}" });
  t.eq(capturedReady, "{\"ok\":true}");

  const getReady = handleDesktopRequest(fs, alloc, "/web", { method: "GET", path: "/api/ready", query: "", headers: [], body: "" }, onReady);
  t.eq(getReady.status, u16(404));

  const wasmRes = handleDesktopRequest(fs, alloc, "/web", { method: "GET", path: "/program.wasm", query: "", headers: [], body: "" }, onReady);
  t.eq(wasmRes.status, u16(200));
  t.eq(wasmRes.headers[0].value, "application/wasm");
  t.eq(wasmRes.body, { kind: "bytes", value: wasmBytes });

  const missWasm = handleDesktopRequest(fs, alloc, "/web", { method: "GET", path: "/missing.wasm", query: "", headers: [], body: "" }, onReady);
  t.eq(missWasm.status, u16(404));
  t.eq(missWasm.body, { kind: "text", value: "not found" });

  const idx = handleDesktopRequest(fs, alloc, "/web/", { method: "GET", path: "/", query: "", headers: [], body: "" }, onReady);
  t.eq(idx.status, u16(200));
  t.eq(idx.headers[0].value, "text/html; charset=utf-8");
  t.eq(idx.body, { kind: "text", value: "<h1>ok</h1>" });

  const jsFile = handleDesktopRequest(fs, alloc, "/web", { method: "GET", path: "/rt/browser.js", query: "", headers: [], body: "" }, onReady);
  t.eq(jsFile.status, u16(200));
  t.eq(jsFile.headers[0].value, "application/javascript; charset=utf-8");

  const bad = handleDesktopRequest(fs, alloc, "/web", { method: "GET", path: "/../x", query: "", headers: [], body: "" }, onReady);
  t.eq(bad.status, u16(400));
  t.eq(bad.headers[0].value, "text/plain; charset=utf-8");
  t.eq(bad.body, { kind: "text", value: "bad path" });

  const miss = handleDesktopRequest(fs, alloc, "/web", { method: "GET", path: "/missing.js", query: "", headers: [], body: "" }, onReady);
  t.eq(miss.status, u16(404));
  t.eq(miss.body, { kind: "text", value: "not found" });
});
