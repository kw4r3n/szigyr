// stage: 3
declare module "c:szcb:szcb.h" {
  function szcb_call(ffi: Ffi, f: Ptr<(ud: Ptr<void>, x: i32) => i32>, ud: Ptr<void>, x: i32): i32;
}
import { szcb_call } from "c:szcb:szcb.h";

function cb(ud: Ptr<void>, x: i32): i32 {
  "use rt";
  "use unsafe";
  return x + 1;
}
export function reg(ffi: Ffi, ud: Ptr<void>): i32 {
  "use owned";
  "use unsafe";
  const p: Ptr<(ud: Ptr<void>, x: i32) => i32> = cfn(cb);
  return szcb_call(ffi, p, ud, 1) + szcb_call(ffi, p, ud, 2);
}
