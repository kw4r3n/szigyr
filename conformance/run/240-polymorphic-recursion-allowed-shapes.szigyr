// expect-output: 7
// stage: 2
// open-question: Q240
type W<T extends Native> = Struct<{ readonly a: T }>;
// the type parameter passed through unchanged, with the parameters swapped, and a closed type argument stay accepted
function same<T>(x: T, n: i32): i32 {
  "use owned";
  if (n === 0) { return 0; }
  return 1 + same<T>(x, n - 1);
}
function swap<A, B>(a: A, b: B, n: i32): i32 {
  "use owned";
  if (n === 0) { return 0; }
  return 1 + swap<B, A>(b, a, n - 1);
}
function wrapOnce<T>(x: T): i32 {
  "use owned";
  return same<W<T>>({ a: x }, 2);
}
function leaf<T>(x: T, n: i32): i32 {
  "use owned";
  if (n === 0) { return 0; }
  return 1 + closed(n - 1);
}
function closed(n: i32): i32 {
  "use owned";
  return leaf<W<i32>>({ a: 1 }, n);
}
export function main(sys: System): void {
  sys.log.info(`${same<i32>(1, 3) + swap<i32, f64>(1, 2.5, 2) + wrapOnce<i32>(5)}`);
}
