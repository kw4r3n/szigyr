// expect-output: 7 7 7
// expect-output: 2.5 3
// expect-output: 3 1
// stage: 2
type Pair<T extends Native> = OwnedStruct<{ readonly a: T; readonly b: T }>;

function fillWith<T extends Copy & Native>(v: Mut<Vec<T>>, x: T, n: usize): void {
  "use owned";
  for (let i: usize = 0; i < n; i += 1) {
    v.push(x);
  }
}

function first<T extends Copy & Native>(s: Ref<Slice<T>>): T {
  "use rt";
  return s[0];
}

function swap<T>(a: T, b: T): Pair<T> {
  "use rt";
  return { a: b, b: a };
}

function firstF(s: Ref<Slice<f32>>): f32 {
  "use rt";
  return first<f32>(s) + first(s);
}

export function main(sys: System): void {
  const v = Vec.create<i32>(sys.alloc, 1);
  fillWith(v, 7, 3);
  sys.log.info(`${v[0]} ${v[2]} ${first(v)}`);
  const f = Vec.create<f32>(sys.alloc, 1);
  fillWith<f32>(f, 1.25, 2);
  sys.log.info(`${firstF(f)} ${v.length}`);
  const p = swap<i32>(1, 3);
  sys.log.info(`${p.a} ${p.b}`);
}
