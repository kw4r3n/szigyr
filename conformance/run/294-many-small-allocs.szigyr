// expect-output: 2194820096
// stage: 2
function allocMany(alloc: Alloc, n: u32): u32 {
  "use owned";
  let sum: u32 = 0;
  for (let i: u32 = 0; i < n; i += 1) {
    const v = Vec.create<u32>(alloc, 16);
    for (let j: u32 = 0; j < 16; j += 1) {
      v.push(wrapAdd(i, j));
    }
    for (let j: usize = 0; j < v.length; j += 1) {
      sum = wrapAdd(sum, v[j]);
    }
  }
  return sum;
}

export function main(sys: System): void {
  sys.log.info(`${allocMany(sys.alloc, 200000)}`);
}
