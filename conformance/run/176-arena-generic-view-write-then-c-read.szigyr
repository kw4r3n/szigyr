// expect-output: c=4 g=4
// expect-output: c=6 g=6
// stage: 2
function rd(v: Ref<Slice<i32>>): i32 {
  "use rt";
  return v[1];
}
function getc(a: Ref<Arena>, b: ArenaBuf<i32>): i32 {
  "use rt";
  return rd(a.view(b));
}
function mk(a: Mut<Arena>): ArenaBuf<i32> | null {
  "use rt";
  return a.alloc<i32>(2, 1);
}
function put<T extends Copy & Native>(s: Mut<Slice<T>>, x: T): void {
  s[1] = x;
}
function putG<T extends Copy & Native>(a: Mut<Arena>, b: ArenaBuf<T>, x: T): void {
  put(a.view(b), x);
}
function get<T extends Copy & Native>(s: Ref<Slice<T>>): T {
  return s[1];
}
function getG<T extends Copy & Native>(a: Ref<Arena>, b: ArenaBuf<T>): T {
  return get(a.view(b));
}
export function main(sys: System): void {
  const a = Arena.create(sys.alloc, 64);
  const b = mk(a);
  const m = a.alloc<i32>(2, 1);
  if (b === null || m === null) {
    return;
  }
  putG(a, b, 4);
  sys.log.info(`c=${getc(a, b)} g=${getG(a, b)}`);
  putG(a, m, 6);
  sys.log.info(`c=${getc(a, m)} g=${getG(a, m)}`);
}
