// expect-output: before=1
// expect-output: after=8
// stage: 2
function mk(a: Mut<Arena>, x: i32): ArenaBuf<i32> | null {
  "use rt";
  return a.alloc<i32>(2, x);
}
function head<T extends Copy & Native>(s: Ref<Slice<T>>): T {
  return s[0];
}
function headG<T extends Copy & Native>(a: Ref<Arena>, b: ArenaBuf<T>): T {
  return head(a.view(b));
}
export function main(sys: System): void {
  const a = Arena.create(sys.alloc, 64);
  const b = mk(a, 1);
  if (b === null) {
    return;
  }
  sys.log.info(`before=${headG(a, b)}`);
  a.reset();
  const c = mk(a, 8);
  if (c === null) {
    return;
  }
  sys.log.info(`after=${headG(a, c)}`);
}
