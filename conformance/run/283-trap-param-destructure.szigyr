type Pt = { readonly x: i32; readonly y: i32 };

function addPt({ x, y }: Pt): i32 {
  "use rt";
  return x + y;
}

export function main(sys: System): void {
  sys.log.info(`${addPt({ x: 10, y: 20 })}`);
  sys.log.info(`${addPt({ x: 2147483647, y: 1 })}`);
}
