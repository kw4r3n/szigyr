// expect-output: 10:16:25|x:|a:b,c|6:40:20|1:9
// stage: 2
// open-question: Q300
// open-question: Q301

class Acc {
  mulAdd(k: i32, ...xs: i32[]): i32 {
    let acc: i32 = 0;
    for (const x of xs) acc += k * x;
    return acc;
  }
}

function sum(base: i32, ...xs: Array<i32>): i32 {
  let acc = base;
  for (const x of xs) acc += x;
  return acc;
}

function joinTag(tag: string = "x", ...parts: string[]): string {
  return `${tag}:${parts.join(",")}`;
}

export function main(sys: System): void {
  const nums: Array<i32> = [3, 4, 8];
  const empty: Array<i32> = [];
  const s1 = sum(10);
  const s2 = sum(10, 1, 2, 3);
  const s3 = sum(10, ...nums);
  const j1 = joinTag();
  const j2 = joinTag("a", "b", "c");

  const arrow = (k: i32, ...xs: Array<i32>): i32 => {
    let acc: i32 = 0;
    for (const x of xs) acc += k * x;
    return acc;
  };

  const acc = new Acc();
  const m1 = acc.mulAdd(2, 1, 2);
  const m2 = acc.mulAdd(4, ...[2, 3, 5]);
  const a1 = arrow(5, ...[1, 3]);
  const fs: Array<f64> = [3.0, 1.0, 9.0, 4.0];
  const lo = i32(Math.min(...fs));
  const hi = i32(Math.max(...fs));

  const checkEmpty = sum(5, ...empty) === 5;
  sys.log.info(
    `${s1}:${s2}:${s3}|${j1}|${j2}|${m1}:${m2}:${checkEmpty ? a1 : -1}|${lo}:${hi}`,
  );
}
