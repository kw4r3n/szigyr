// expect-output: ff:255:ff:-1010|3.14:5:7.0|10:30:null:20:null|1,3,5,8/5,3,8,1|8,5,3,1|1,99,100,4/2,3|10/20,30|1,7,8,9|42:1,2|3:true:1,2,3:10,20:k1,k2|k1,k2/1,2/k1=1,k2=2/k1:1,k2:2/1,2,3,4
// stage: 2
// open-question: Q309

function fmtOpt(v: i32 | null): string {
  return v !== null ? `${v}` : "null";
}

export async function main(sys: System): Promise<void> {
  const n64: i64 = 255;
  const neg64: i64 = -10;
  const numPart = `${(255).toString(16)}:${(255).toString()}:${n64.toString(16)}:${neg64.toString(2)}`;

  const n32: i32 = 7;
  const fixedPart = `${(3.14159).toFixed(2)}:${(5).toFixed()}:${n32.toFixed(1)}`;

  const xs: Array<i32> = [10, 20, 30];
  const ro: ReadonlyArray<i32> = xs;
  const atPart = `${fmtOpt(xs.at(0))}:${fmtOpt(xs.at(-1))}:${fmtOpt(xs.at(99))}:${fmtOpt(ro.at(-2))}:${fmtOpt(ro.at(-99))}`;

  const raw: Array<i32> = [5, 3, 8, 1];
  const rawRo: ReadonlyArray<i32> = raw;
  const sorted = raw.toSorted((a: i32, b: i32): f64 => f64(a - b));
  const sortedRo = rawRo.toSorted((a: i32, b: i32): f64 => f64(b - a));

  const a: Array<i32> = [1, 2, 3, 4];
  const remA = a.splice(1, 2, 99, 100);
  const b: Array<i32> = [10, 20, 30];
  const remB = b.splice(1);
  const tail: Array<i32> = [7, 8];
  const c: Array<i32> = [1, 9];
  c.splice(1, 0, ...tail);
  const splicePart = `${a.join(",")}/${remA.join(",")}|${b.join(",")}/${remB.join(",")}|${c.join(",")}`;

  await Promise.resolve();
  const p1 = await Promise.resolve(42);
  const ps = await Promise.all([Promise.resolve(1), Promise.resolve(2)]);
  const promisePart = `${p1}:${ps.join(",")}`;

  const s1 = new Set<number>([1, 2, 2, 3]);
  const s2 = new Set([10, 20, 10]);
  const m = new Map<string, i32>();
  m.set("k1", 1);
  m.set("k2", 2);
  const s3 = new Set<string>(m.keys());
  const setPart = `${s1.size}:${s1.has(2)}:${[...s1].join(",")}:${[...s2].join(",")}:${[...s3].join(",")}`;

  const ks = [...m.keys()].join(",");
  const vs = [...m.values()].join(",");
  const es = [...m.entries()].map((p) => `${p[0]}=${p[1]}`).join(",");
  const ms = [...m].map((p) => `${p[0]}:${p[1]}`).join(",");
  const ss = [...s1, 4].join(",");
  const spreadPart = `${ks}/${vs}/${es}/${ms}/${ss}`;

  sys.log.info(`${numPart}|${fixedPart}|${atPart}|${sorted.join(",")}/${raw.join(",")}|${sortedRo.join(",")}|${splicePart}|${promisePart}|${setPart}|${spreadPart}`);
}
