// expect-trap: T002 @ 15:16
// stage: 2
type Box = OwnedStruct<{ data: Vec<u32>; n: u32 }>;
function make(alloc: Alloc): Box {
  "use owned";
  const d = Vec.create<u32>(alloc, 2);
  d.push(1);
  return { data: d, n: 1 };
}
function trapAfterSet(b: Mut<Box>, alloc: Alloc, i: usize): void {
  "use owned";
  const nv = Vec.create<u32>(alloc, 1);
  nv.push(42);
  b.data = nv;
  b.n = b.data[i];
}
export function main(sys: System): void {
  const b = make(sys.alloc);
  trapAfterSet(b, sys.alloc, 5);
  sys.log.info(`${b.n}`);
}
