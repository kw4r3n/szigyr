  function szcb_cppp(ffi: Ffi, p: ConstPtr<Ptr<Ptr<i32>>>): i32;
  function szcb_ppfn(ffi: Ffi, p: Ptr<Ptr<(x: i32) => i32>>): i32;
  function szcb_cpfn(ffi: Ffi, p: ConstPtr<Ptr<(x: i32) => i32>>): i32;
