import { szcb_cpp, szcb_cppp, szcb_ppfn, szcb_cpfn } from "c:szcb:szcb_audit.h";
function inc(x: i32): i32 {
  "use rt";
  return x + 1;
}
function go(ffi: Ffi, alloc: Alloc): i32 {
  "use owned";
