// expect-output: v=3 len=2 head=1.5
// expect-output: w=10 len=4
// stage: 2
// open-question: Q188
// open-question: Q215
function allocSum(a: Mut<Arena>, n: usize, x: f32): ArenaBuf<f32> | null {
  "use rt";
  return a.alloc<f32>(n, x); // Q215 (c): a concrete element; the views below stay generic
}

function head<T extends Copy & Native>(s: Ref<Slice<T>>): T {
  "use rt";
  return s[0];
}

function headG<T extends Copy & Native>(a: Ref<Arena>, b: ArenaBuf<T>): T {
  "use rt";
  return head(a.view(b));
}

function readG(a: Ref<Arena>, b: ArenaBuf<f32>): f32 {
  "use rt";
  return sumF(a.view(b));
}

function sumF(s: Ref<Slice<f32>>): f32 {
  "use rt";
  let acc: f32 = 0;
  for (let i: usize = 0; i < s.length; i += 1) {
    acc += s[i];
  }
  return acc;
}

export function main(sys: System): void {
  const a = Arena.create(sys.alloc, 64);
  const b = allocSum(a, 2, 1.5);
  if (b === null) {
    return;
  }
  sys.log.info(`v=${readG(a, b)} len=${b.length} head=${headG(a, b)}`);
  const c = allocSum(a, 4, 2.5);
  if (c === null) {
    return;
  }
  sys.log.info(`w=${readG(a, c)} len=${c.length}`);
}
