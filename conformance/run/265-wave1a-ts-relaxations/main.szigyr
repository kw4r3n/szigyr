// expect-output: 43:108:hi:42:10:a:52
// stage: 2
import * as b from "./barrel.szigyr";
import type * as tb from "./barrel.szigyr";
import { type Pair, sumPlusOne } from "./lib.szigyr";

type AB = "a" | "b";

const FIXED: readonly i32[] = [1, 2, 3];

class MyGreeter implements tb.Greeter {
  greet(): string {
    return "hi";
  }
}

function useStrictNs(x: i32): i32 {
  "use owned";
  const p: Pair = { x: b.FACTOR, y: 20 };
  const picked = b.pickFirst<i32>(p.x, p.y, true);
  return b.mulScale(x) + b.applyRt(1, b.mulScale) + picked;
}

export function main(sys: System): void {
  const arr: i32[] = [10, 20];
  let total: i32 = 0;
  for (let x of arr) {
    x += 2;
    total += x;
  }
  const sFixed = sumPlusOne(FIXED);
  const c = new b.Counter(b.Counter.BASE);
  const cv = c.inc(8);
  const g = new MyGreeter();
  const r: Result<i32, string> = Result.ok(40);
  const rv = r.kind === "ok" ? r.value : 0;
  const p2: tb.Pair = { x: rv, y: 2 };
  const ab: AB = "a";
  const strictVal = useStrictNs(2);
  sys.log.info(`${total + sFixed}:${cv}:${g.greet()}:${p2.x + p2.y}:${b.FACTOR}:${ab}:${strictVal}`);
}
