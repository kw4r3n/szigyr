// A C thread's trap claims the end flag before main traps in managed code without passing a
// surfacing point: the first trap to claim the flag is the reported one (§15.4, D144).
declare module "c:szcb:szcb.h" {
  function szcb_start(ffi: Ffi, f: Ptr<(ud: Ptr<void>, x: i32) => i32>, ud: Ptr<void>, x: i32, delay: i32, after: Ptr<(ud: Ptr<void>, x: i32) => i32>, aud: Ptr<void>): void;
}
import { szcb_start } from "c:szcb:szcb.h";

function boom(ud: Ptr<void>, x: i32): i32 {
  "use rt";
  "use unsafe";
  const y: i32 = x;
  return y + 1;
}
function noop(ud: Ptr<void>, x: i32): i32 {
  "use rt";
  "use unsafe";
  return 0;
}
function arm(ffi: Ffi, alloc: Alloc): void {
  "use owned";
  "use unsafe";
  const ud = Ptr.box(alloc, 0);
  szcb_start(ffi, cfn(boom), ud.cast<void>(), 2147483647, 50, cfn(noop), ud.cast<void>());
}
export function main(sys: System): void {
  arm(sys.ffi, sys.alloc);
  sys.log.info("armed");
  let i: i32 = 0;
  while (i < 200000000) { i += 1; }
  panic("main");
}
