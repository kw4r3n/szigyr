declare module "c:szcb:szcb.h" {
  function szcb_start(ffi: Ffi, f: Ptr<(ud: Ptr<void>, x: i32) => i32>, ud: Ptr<void>, x: i32, delay: i32, after: Ptr<(ud: Ptr<void>, x: i32) => i32>, aud: Ptr<void>): void;
  function szcb_join(ffi: Ffi): void;
}
import { szcb_start, szcb_join } from "c:szcb:szcb.h";

type State = OwnedStruct<{ rx: RingRx<i32>; sum: i32 }>;

function drain(s: Mut<State>): void {
  "use rt";
  let sum: i32 = 0;
  while (true) {
    const v = s.rx.pop();
    if (v === null) { continue; }
    if (v === -1) { break; }
    sum += v;
  }
  s.sum = sum;
}
function popper(ud: Ptr<void>, x: i32): i32 {
  "use rt";
  "use unsafe";
  const p = ud.cast<State>();
  drain(p.borrow());
  return 0;
}
function noop(ud: Ptr<void>, x: i32): i32 {
  "use rt";
  "use unsafe";
  return 0;
}
function arm(ffi: Ffi, alloc: Alloc, rx: RingRx<i32>): CHandle<State> {
  "use owned";
  "use unsafe";
  const st: State = { rx, sum: 0 };
  const p = Ptr.box(alloc, st);
  szcb_start(ffi, cfn(popper), p.cast<void>(), 0, 0, cfn(noop), p.cast<void>());
  return CHandle.create(p);
}
function readSum(s: Ref<State>): i32 {
  "use rt";
  return s.sum;
}
function finish(ffi: Ffi, h: CHandle<State>): i32 {
  "use owned";
  "use unsafe";
  szcb_join(ffi);
  const p = h.get();
  return readSum(p.borrow());
}
export function main(sys: System): void {
  const { tx, rx } = Ring.create<i32>(sys.alloc, 128);
  const h = arm(sys.ffi, sys.alloc, rx);
  let i: i32 = 1;
  while (i <= 10) {
    tx.push(i);
    i += 1;
  }
  tx.push(-1);
  const total = finish(sys.ffi, h);
  sys.log.info(`${total}`);
}
