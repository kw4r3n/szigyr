declare module "c:szcb:szcb.h" {
  function szcb_call(ffi: Ffi, f: Ptr<(ud: Ptr<void>, x: i32) => i32>, ud: Ptr<void>, x: i32): i32;
  function szcb_thread(ffi: Ffi, f: Ptr<(ud: Ptr<void>, x: i32) => i32>, ud: Ptr<void>, x: i32): i32;
}
import { szcb_call, szcb_thread } from "c:szcb:szcb.h";

type R = Struct<{ a: i32; b: i32 }>;

function twice(ud: Ptr<void>, x: i32): i32 {
  "use rt";
  "use unsafe";
  return x * 2;
}
function go(ffi: Ffi, alloc: Alloc): R {
  "use owned";
  "use unsafe";
  const ud = Ptr.box(alloc, 0);
  const p: Ptr<(ud: Ptr<void>, x: i32) => i32> = cfn(twice);
  const a = szcb_call(ffi, p, ud.cast<void>(), 21);
  const b = szcb_thread(ffi, p, ud.cast<void>(), 4);
  return { a, b };
}
export function main(sys: System): void {
  const r = go(sys.ffi, sys.alloc);
  sys.log.info(`${r.a} ${r.b}`);
}
