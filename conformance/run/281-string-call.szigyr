// expect-output: str:|szigyr:true
// expect-output: int:-128|127|255|-32000|65000|-42|0|4294967295:true
// expect-output: i64u64:-4611686018427387909|9223372036854775813:true
// expect-output: flt:1.5|0|1.5|-42.25|NaN|Infinity|-Infinity:true
// expect-output: bool:true|false|true:true
// stage: 2

export function main(sys: System): void {
  const s0: string = "";
  const s1: string = "szigyr";
  sys.log.info(`str:${String(s0)}|${String(s1)}:${String(s0) === `${s0}` && String(s1) === `${s1}`}`);

  const vi8a: i8 = -128;
  const vi8b: i8 = 127;
  const vu8: u8 = 255;
  const vi16: i16 = -32000;
  const vu16: u16 = 65000;
  const vi32: i32 = -42;
  const vz: i32 = 0;
  const vu32: u32 = 4294967295;
  const intEq =
    String(vi8a) === `${vi8a}` &&
    String(vi8b) === `${vi8b}` &&
    String(vu8) === `${vu8}` &&
    String(vi16) === `${vi16}` &&
    String(vu16) === `${vu16}` &&
    String(vi32) === `${vi32}` &&
    String(vz) === `${vz}` &&
    String(vu32) === `${vu32}`;
  sys.log.info(`int:${String(vi8a)}|${String(vi8b)}|${String(vu8)}|${String(vi16)}|${String(vu16)}|${String(vi32)}|${String(vz)}|${String(vu32)}:${intEq}`);

  const bi64: i64 = -(i64(1) << 62) - 5;
  const bu64: u64 = (u64(1) << 63) + 5;
  sys.log.info(`i64u64:${String(bi64)}|${String(bu64)}:${String(bi64) === `${bi64}` && String(bu64) === `${bu64}`}`);

  const vf32: f32 = f32(1.5);
  const fz: f64 = 0.0;
  const fnz: f64 = -0.0;
  const f1: f64 = 1.5;
  const f2: f64 = -42.25;
  const fnan: f64 = Number.NaN;
  const finf: f64 = Number.POSITIVE_INFINITY;
  const fninf: f64 = Number.NEGATIVE_INFINITY;
  const fltEq =
    String(vf32) === `${vf32}` &&
    String(fz) === `${fz}` &&
    String(fnz) === `${fnz}` &&
    String(f1) === `${f1}` &&
    String(f2) === `${f2}` &&
    String(fnan) === `${fnan}` &&
    String(finf) === `${finf}` &&
    String(fninf) === `${fninf}`;
  sys.log.info(`flt:${String(vf32)}|${String(fnz)}|${String(f1)}|${String(f2)}|${String(fnan)}|${String(finf)}|${String(fninf)}:${fltEq}`);

  const bt: boolean = true;
  const bf: boolean = false;
  const bv = Vec.create<boolean>(sys.alloc, 1);
  bv.push(true);
  const boolEq = String(bt) === `${bt}` && String(bf) === `${bf}` && String(bv[0]) === `${bv[0]}`;
  sys.log.info(`bool:${String(bt)}|${String(bf)}|${String(bv[0])}:${boolEq}`);
}
