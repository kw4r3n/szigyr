type W = OwnedStruct<{ a: Vec<f32>; b: Vec<f32> }>;
function mk(alloc: Alloc): Vec<f32> {
  "use owned";
  return Vec.create<f32>(alloc, 2);
}
function eat(v: Vec<f32>): usize {
  "use owned";
  return v.length;
}
function mn(a: Mut<Vec<f32>>, n: usize): void {
  "use owned";
  a.push(f32(n));
}
