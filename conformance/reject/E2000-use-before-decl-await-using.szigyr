class AD implements AsyncDisposable {
  readonly id: i32;
  constructor(id: i32) { this.id = id; }
  async disposeAsync(): Promise<void> {}
}
export async function main(sys: System): Promise<void> {
  const r = new AD(1);
  {
    const a = r.id;
    await using r = new AD(2);
    sys.log.info(`${a}|${r.id}`);
  }
}
