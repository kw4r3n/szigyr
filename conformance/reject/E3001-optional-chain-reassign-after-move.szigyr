type S = OwnedStruct<{ n: i32 }>;
interface I { m(x: i32): void }
function mk(): S { return { n: 1 }; }
function eat(s: S): i32 { return s.n; }
export function f(o: I | null): i32 {
  let v: S = mk();
  eat(v);
  o?.m((v = mk()).n);
  return v.n;
}
