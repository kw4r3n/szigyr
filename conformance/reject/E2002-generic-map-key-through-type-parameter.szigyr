type P = { readonly x: f64 };
function keys<K extends Key>(k: K): usize {
  const m: Map<K, i32> = new Map<K, i32>();
  m.set(k, 1);
  return m.size;
}
function outer<U extends Key>(u: U): usize {
  return keys<U>(u);
}
function f(p: P): usize {
  return outer<P>(p);
}
