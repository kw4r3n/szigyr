function make(alloc: Alloc): Vec<f32> {
  "use owned";
  return Vec.create<f32>(alloc, 2);
}
function first(s: Ref<Slice<f32>>): f32 {
  "use owned";
  return s[0];
}
function f(alloc: Alloc): f32 {
  "use owned";
  return first(make(alloc).borrowSlice(0, 1));
}
