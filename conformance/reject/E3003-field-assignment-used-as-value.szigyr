type W = OwnedStruct<{ a: Vec<f32>; b: Vec<f32> }>;
function mk(alloc: Alloc): Vec<f32> {
  "use owned";
  return Vec.create<f32>(alloc, 2);
}
function eat(v: Vec<f32>): usize {
  "use owned";
  return v.length;
}
function f(al: Alloc): usize {
  "use owned";
  const w: W = { a: mk(al), b: mk(al) };
  const x = (w.a = mk(al));
  return eat(x) + w.a.length;
}
