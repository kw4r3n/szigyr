type CB = (x: usize, i: usize) => usize;
function F(x: usize, i: usize, z: usize = 5): usize { return z; }
export function run(a: Array<usize>): Array<usize> {
  const cb: CB | null = F;
  return a.map(cb ?? ((x: usize, i: usize): usize => x));
}
