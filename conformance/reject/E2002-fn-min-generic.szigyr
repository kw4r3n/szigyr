// open-question: Q315
function addWithBias(x: i32, b: i32 = 10): i32 { return x + b; }
function add(x: i32, d: i32): i32 { return x + d; }
function pick<T>(a: T, b: T, c: boolean): T { return c ? a : b; }
export function run(): i32 {
  const h = pick(addWithBias, add, false);
  return h(5);
}
