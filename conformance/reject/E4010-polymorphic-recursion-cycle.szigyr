type W<T extends Native> = Struct<{ readonly a: T }>;
function f<T>(x: T, n: i32): i32 {
  "use owned";
  if (n === 0) { return 0; }
  const p: W<T> = { a: x };
  return 1 + g<W<T>>(p, n - 1);
}
function g<U>(y: U, n: i32): i32 {
  "use owned";
  return f<U>(y, n);
}
export function main(sys: System): void {
  sys.log.info(`${f<i32>(1, 3)}`);
}
